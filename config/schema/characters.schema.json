{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "characters.schema.json",
  "type": "object",
  "required": ["villager", "spear", "shooter"],
  "additionalProperties": {
    "type": "object",
    "required": ["sheets", "skins", "frame", "foot", "faces_right", "clips"],
    "properties": {
      "sheets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "skins": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "frame": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "number", "exclusiveMinimum": 0}
      },
      "foot": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "number"}
      },
      "faces_right": {"type": "boolean"},
      "clips": {
        "type": "object",
        "required": ["idle", "move"]
      },
      "spine": {"type": "object"}
    }
  }
}
